{{define "title"}}Login{{end}}

{{define "main"}}
<section class='auth-layout'>
    <div class='auth-intro'>
        <span class='eyebrow'>Welcome back</span>
        <h1>Continue the conversation.</h1>
        <p>Sign in to publish posts, write comments and react to discussions.</p>
        <div class='auth-decoration' aria-hidden='true'><span></span><span></span><span></span></div>
    </div>
    <div class='form-panel'>
        <div class='panel-heading'>
            <h2>Log in</h2>
            <p>Use the email connected to your account.</p>
        </div>
        <form action='/user/login' method='POST' novalidate>
            <div class='form-group'>
                <label for='email'>Email address</label>
                {{with .Form.FieldErrors.email}}<span class='field-error'>{{.}}</span>{{end}}
                <input id='email' type='email' name='email' value='{{.Form.Email}}' placeholder='you@example.com' autocomplete='email'>
            </div>
            <div class='form-group'>
                <label for='password'>Password</label>
                {{with .Form.FieldErrors.password}}<span class='field-error'>{{.}}</span>{{end}}
                <input id='password' type='password' name='password' placeholder='Enter your password' autocomplete='current-password'>
            </div>
            <button class='button button-full' type='submit'>Log in</button>
        </form>
        <p class='form-switch'>New here? <a href='/user/signup'>Create an account</a></p>
    </div>
</section>
{{end}}
