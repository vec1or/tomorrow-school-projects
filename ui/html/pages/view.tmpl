{{define "title"}}Post #{{.Post.ID}}{{end}}

{{define "main"}}
    {{with .Post}}
        <div class='post'>
            <div class='metadata'>
                <strong>{{.Title}}</strong>
                <span>#{{.ID}}</span>
            </div>
            <pre><code>{{.Content}}</code></pre>
            <div class='metadata'>
                <time>Created: {{humandate .CreatedAt}}</time>
            </div>
        </div>
    {{end}}

    <h3>Comments</h3>
    {{if .Comments}}
        {{range .Comments}}
            <div class='comment'>
                <div class='metadata'>
                    <strong>{{.Username}}</strong>
                    <time>{{humandate .CreatedAt}}</time>
                </div>
                <p>{{.Content}}</p>
            </div>
        {{end}}
    {{else}}
        <p>No comments yet.</p>
    {{end}}
{{end}}